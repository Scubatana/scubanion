DB_DATABASE=scubatana
DB_USERNAME=scubatana
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

NGINX_PORT=8000
PHPMYADMIN_PORT=8080
FRONTEND_PORT=3000
MQTT_PORT=1883

# Prod (docker-compose.yml)
APP_KEY=
APP_URL=http://localhost:8000
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
BREVO_API_KEY=
MQTT_USERNAME=scubanion.api
MQTT_PASSWORD=changeme
# MQTT chiffré pour les bornes (voir docs/mqtt.md, « Chiffrement TLS ») : dossier de l'hôte qui contient
# seulement le certificat et la clé de scuba.picsou06.fr (copiés là par un deploy hook certbot, pas tout
# /etc/letsencrypt), et leurs noms dans ce dossier.
MQTT_TLS_PORT=8883
MQTT_TLS_DIR=/opt/scubatana/certificat-mqtt
MQTT_TLS_CERT=fullchain.pem
MQTT_TLS_KEY=privkey.pem

DOCKERHUB_NAMESPACE=scubatana
IMAGE_TAG=latest

# Monitoring (Prometheus / Grafana)
# Interfaces publiées sur l'hôte : 127.0.0.1 (accès par tunnel SSH) sauf besoin explicite.
MONITORING_BIND=127.0.0.1
METRICS_TOKEN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
